#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# AngurIA AI service
ai_service/.venv/
# Ignora i file di training, ma conserva il modello Beta
ai_service/runs/*
/runs/
*.pt

!ai_service/runs/watermelon_v1/
ai_service/runs/watermelon_v1/*

!ai_service/runs/watermelon_v1/weights/
ai_service/runs/watermelon_v1/weights/*

!ai_service/runs/watermelon_v1/weights/best.pt
__pycache__/
*.pyc

*.cache

# AngurIA - training split generato automaticamente
ai_service/datasets/watermelon/images/train/
ai_service/datasets/watermelon/images/val/
ai_service/datasets/watermelon/labels/train/
ai_service/datasets/watermelon/labels/val/

# AngurIA - deploy model V3
!ai_service/runs/watermelon_v3/
!ai_service/runs/watermelon_v3/weights/
!ai_service/runs/watermelon_v3/weights/best.pt

# AngurIA - file locali e temporanei
ai_service/.pids/

# Backup automatici Python/Dart
ai_service/*_before_*.py
ai_service/*_backup.py
ai_service/*_stable_*.py
ai_service/*_working_*.py
ai_service/intelligence/*_before_*.py
ai_service/intelligence/*_stable_*.py
lib/**/*_before_*.dart
lib/**/*_backup.dart
lib/**/*_stabile_*.dart

# Report e artefatti diagnostici generati
ai_service/reports/
ai_service/datasets/watermelon/analysis_history/
ai_service/datasets/watermelon/annotation_previews/
ai_service/datasets/watermelon/cleanup_backups/

# AngurIA V3 - conserva solo il modello deployabile
ai_service/runs/watermelon_v3/*
!ai_service/runs/watermelon_v3/weights/
ai_service/runs/watermelon_v3/weights/*
!ai_service/runs/watermelon_v3/weights/best.pt

# AngurIA - ulteriori backup/temporanei
ai_service/*_signal_fix_*.py
ai_service/scripts/*_before_*.py
ai_service/scripts/*_before_retry_*.py
ai_service/datasets/watermelon/raw/opened_external/
